# Traid configuration. Copy to `.env` and adjust if needed.
# All values have safe defaults; Traid needs NO secrets or API keys.

# development | production | test
TRAID_ENV=development

# Bind address. Traid only allows loopback addresses (127.0.0.1 / localhost / ::1).
TRAID_HOST=127.0.0.1
TRAID_PORT=8765

# Where the database, images, backups and logs are stored (relative to the repo root or absolute).
TRAID_DATA_DIR=./data

# Where ONNX model files and models/manifest.json live.
TRAID_MODEL_DIR=./models

# Inference device: auto | cpu | directml | cuda
TRAID_DEVICE=auto

# GPU adapter for DirectML/CUDA (used from Phase 4): auto = adapter with the most
# dedicated VRAM (the NVIDIA RTX 3050 on the owner's laptop), or an adapter index.
# TRAID_GPU_DEVICE_ID=auto

# Upload limits
TRAID_MAX_UPLOAD_MB=50
TRAID_MAX_PIXELS=40000000

# Sessions
TRAID_SESSION_IDLE_HOURS=12
TRAID_SESSION_MAX_DAYS=7

# DEBUG | INFO | WARNING | ERROR
TRAID_LOG_LEVEL=INFO

# Development seed only (scripts/seed_dev.py). Refused when TRAID_ENV=production.
# TRAID_DEV_PASSWORD=

# Frontend (build-time, PUBLIC — never put secrets in VITE_ variables)
VITE_API_BASE=/api/v1
